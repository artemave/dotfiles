#!/usr/bin/env bash
# Write the secrets the devcontainer's secrets-proxy injects into
# $XDG_RUNTIME_DIR/devcontainer-secrets (tmpfs), one file per secret. Only the
# proxy container mounts this directory. Run before every compose `up`; a
# secret whose source is empty or missing on the host is removed, and the proxy
# answers requests that need it with a 502 naming it.
set -euo pipefail

dir="$XDG_RUNTIME_DIR/devcontainer-secrets"
install -d -m 700 "$dir"
umask 077

write() {
  if [[ -n $2 ]]; then
    printf '%s' "$2" > "$dir/$1"
  else
    rm -f "$dir/$1"
  fi
}

write openai "$(secret-tool lookup service openai-api-key 2>/dev/null || true)"
write github "$(gh auth token 2>/dev/null || true)"
write claude "$(secret-tool lookup service claude-code-oauth-token 2>/dev/null || true)"
write atlassian "$(secret-tool lookup service atlassian-api-token 2>/dev/null || true)"
